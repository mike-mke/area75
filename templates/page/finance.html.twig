{% extends 'base.html.twig' %}
{% block title %}Finance Committee | Area 75{% endblock %}
{% block body %}
<div class="page-title-bar">
  <div class="container">
    <div class="breadcrumb"><a href="{{ path('app_home') }}">Home</a> › <a href="#">Area Business</a> › <span>Finance</span></div>
    <h1>Finance Committee</h1>
  </div>
</div>
<div class="page-content">
  <div class="container" style="max-width:720px;">

    <div class="panel" style="background:var(--cream-dark); text-align:center; margin-bottom:2rem;">
