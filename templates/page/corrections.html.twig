{% extends 'base.html.twig' %}
{% block title %}Corrections Committee | Area 75{% endblock %}
{% block body %}
<div class="page-title-bar">
  <div class="container">
    <div class="breadcrumb"><a href="{{ path('app_home') }}">Home</a> › <a href="#">Area Business</a> › <span>Corrections</span></div>
    <h1>Corrections Committee</h1>
  </div>
</div>
<div class="page-content">
  <div class="container" style="max-width:820px;">

    <div class="content-section">
      <p>The Corrections Literature Fund provides AA and Grapevine literature to jails and prisons in Area 75.</p>
      <p>There are currently AA meetings for incarcerated A.A.s at many Area 75 correctional facilities. Volunteers bring meetings inside — a vital service for those behind the walls.</p>

      <div class="panel" style="background:var(--cream-dark);">
        <h3>Donate to the Corrections Literature Fund</h3>
        <address style="font-style:normal; line-height:2;">
          <strong>Area 75 Treasurer</strong><br>
          ATTENTION: Corrections Literature Fund<br>
          6580 Monona Drive #1040<br>
          Monona, WI 53716
        </address>
      </div>

      <div class="panel" style="background:var(--cream-dark); margin-top:1.5rem;">
        <h3>Contact the Corrections Chair</h3>
        <address style="font-style:normal;">
          <strong>Fred K.</strong><br>
          📞 608-296-5084 &nbsp;|&nbsp; <a href="mailto:corrections@area75.org">corrections@area75.org</a>
        </address>
      </div>
    </div>

    <div class="content-section">
      <h2>Pre-release Forms</h2>
      <ul class="pdf-link-list">
        <li><a href="https://drive.google.com/file/d/1JKwmjMMwxQHig5I0fzhZGFgwHmWsvxZu/view?usp=share_link" target="_blank" rel="noopener">Pre-release form for requesting an outside writer — for inmates (English)</a></li>
        <li><a href="https://drive.google.com/file/d/1NT_j9dKbDoKa7uVMsSstvx05gJFG2JDX/view?usp=share_link" target="_blank" rel="noopener">Pre-release form for requesting an outside writer — for inmates (Spanish)</a></li>
        <li><a href="https://drive.google.com/file/d/1tYdivDGSfan9LGOTncrcHlVAKLnk9HvB/view?usp=share_link" target="_blank" rel="noopener">Pre-release form — for outside volunteers (English)</a></li>
        <li><a href="https://drive.google.com/file/d/122Myx0Fx6SZ5y1yA0JIBPgr4ZkvbJJ1G/view?usp=share_link" target="_blank" rel="noopener">Pre-release form — for outside volunteers (Spanish)</a></li>
      </ul>
    </div>

    <p style="font-style:italic; font-family:var(--font-serif); color:var(--brown-rich); font-size:1.05rem;">"Carrying the message keeps us sober and is a good way to give back what was so freely given to us."</p>

  </div>
</div>
{% endblock %}
