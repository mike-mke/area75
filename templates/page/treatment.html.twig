{% extends 'base.html.twig' %}
{% block title %}Treatment Committee | Area 75{% endblock %}
{% block body %}
<div class="page-title-bar">
  <div class="container">
    <div class="breadcrumb"><a href="{{ path('app_home') }}">Home</a> › <a href="#">Area Business</a> › <span>Treatment</span></div>
    <h1>Treatment Committee</h1>
  </div>
</div>
<div class="page-content">
  <div class="container" style="max-width:760px;">
    <div class="content-section">
      <p>The purpose of the Area 75 Treatment Committee is to help AA members carry the message of Alcoholics Anonymous into Treatment Facilities, and help "Bridge the Gap" between the Facilities and AA.</p>
      <p>If you are sober and have a desire to serve — or would like more information about Treatment Committee work — please reach out. Our chair can help you get started and introduce you to people in your district already involved in this important work.</p>
    </div>
    <div class="panel" style="background:var(--cream-dark);">
      <h3>Contact the Treatment Chair</h3>
      <p><a href="mailto:treatment@area75.org" style="font-weight:700; font-size:1.05rem;">treatment@area75.org</a></p>
    </div>
  </div>
</div>
{% endblock %}
