{% extends 'base.html.twig' %}
{% block title %}Add Event | Area 75{% endblock %}

{% block body %}
<div class="page-title-bar">
  <div class="container">
    <div class="breadcrumb"><a href="{{ path('app_home') }}">Home</a> › <a href="{{ path('app_calendar') }}">Events</a> › <span>Add Event</span></div>
    <h1>Submit an Event</h1>
    <p>Events are reviewed before appearing on the calendar.</p>
  </div>
</div>

<div class="page-content">
  <div class="container">
    <div class="form-wrap symfony-form" style="max-width:700px;">
      {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}

        <div class="form-row">
          {{ form_label(form.title) }}
          {{ form_widget(form.title) }}
          {{ form_errors(form.title) }}
        </div>

        <div class="form-row">
          {{ form_label(form.description) }}
          {{ form_widget(form.description) }}
          {{ form_errors(form.description) }}
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
          <div class="form-row">
            {{ form_label(form.startDate) }}
            {{ form_widget(form.startDate) }}
            {{ form_errors(form.startDate) }}
          </div>
          <div class="form-row">
            {{ form_label(form.endDate) }}
            {{ form_widget(form.endDate) }}
            {{ form_errors(form.endDate) }}
          </div>
        </div>

        <div class="form-row">
          {{ form_label(form.location) }}
          {{ form_widget(form.location) }}
          {{ form_errors(form.location) }}
        </div>

        <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:1rem;">
          <div class="form-row">
            {{ form_label(form.address) }}
            {{ form_widget(form.address) }}
          </div>
          <div class="form-row">
            {{ form_label(form.city) }}
            {{ form_widget(form.city) }}
          </div>
          <div class="form-row">
            {{ form_label(form.state) }}
            {{ form_widget(form.state) }}
          </div>
        </div>

        <div class="form-row">
          {{ form_label(form.zoomLink) }}
          {{ form_widget(form.zoomLink) }}
          {{ form_errors(form.zoomLink) }}
        </div>

        <div class="form-row">
          {{ form_label(form.flyerFile) }}
          {{ form_widget(form.flyerFile) }}
          {{ form_errors(form.flyerFile) }}
          <small style="color:var(--text-muted); font-size:.8rem;">PDF files only · max 5 MB</small>
        </div>

        <div class="form-row" style="background:var(--cream-dark); padding:1rem; border-radius:var(--radius); border:1px solid var(--tan-border);">
          <p style="font-size:.875rem; font-weight:700; margin-bottom:.75rem; color:var(--brown-rich);">Based on the Twelve Traditions, only AA events will be accepted. Please confirm:</p>
          <div class="form-check">
            {{ form_widget(form.agreeTerms) }}
            {{ form_label(form.agreeTerms) }}
          </div>
          {{ form_errors(form.agreeTerms) }}
        </div>

        <div style="margin-top:1.5rem; display:flex; gap:1rem; flex-wrap:wrap;">
          <button type="submit" class="btn btn-primary btn-lg">Submit Event</button>
          <a href="{{ path('app_calendar') }}" class="btn btn-outline">Cancel</a>
        </div>

      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
