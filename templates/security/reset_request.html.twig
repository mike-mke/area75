{% extends 'base.html.twig' %}
{% block title %}Forgot Password | Area 75{% endblock %}

{% block body %}
<div class="page-title-bar">
  <div class="container">
    <h1>Forgot Your Password?</h1>
    <p>Enter your email and we'll send you a reset link.</p>
  </div>
</div>

<div class="page-content">
  <div class="container">
    <div class="form-wrap symfony-form">
      {{ form_start(form) }}

        <div class="form-row">
          {{ form_label(form.email) }}
          {{ form_widget(form.email) }}
          {{ form_errors(form.email) }}
        </div>

        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Send Reset Link</button>

      {{ form_end(form) }}

      <div style="text-align:center; margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid var(--tan-border);">
        <a href="{{ path('app_login') }}" style="font-size:.9rem;">← Back to login</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
